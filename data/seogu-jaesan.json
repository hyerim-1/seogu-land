{
  "설명": "대전 서구 국·공유재산 현황. 시유·구유는 실제 집계이고 국유는 예시입니다.",
  "출처": {
    "시유·구유": {
      "시스템": "대전광역시 재산정보 공개시스템",
      "주소": "https://www.daejeon.go.kr/jaesan/PropertyList.do",
      "담당": "대전광역시 회계과 재산관리담당",
      "기준월": "2026년 4월",
      "수집일": "2026-09-16",
      "수집방법": "소재지 서구 + 소유자 구분(시유/구유) + 대부정보 조건으로 검색한 건수"
    },
    "국유": {
      "시스템": "e나라재산 국유재산포털",
      "주소": "https://www.k-pis.go.kr/addMapView.do",
      "상태": "미연계",
      "사유": "필지별 조회에 공공데이터포털 오픈API 인증키가 필요합니다. 화면 수집은 하지 않습니다. 지도의 국유(초록) 표시는 예시입니다."
    }
  },
  "합계": {
    "시유": 2415,
    "구유": 3600,
    "시유_활용가능": 55
